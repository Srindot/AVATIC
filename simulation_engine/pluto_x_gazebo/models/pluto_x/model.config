<?xml version="1.0"?>
<model>
  <name>pluto_x</name>
  <version>0.1</version>
  <sdf version="1.10">model.sdf.xacro</sdf>
  <description>
    Preliminary Pluto X model flown by the legacy kwad.cpp controller stack.
    Must be processed with xacro (config_file:=...) before use; see
    pluto_x_bringup/launch/legacy_sim.launch.py. Mass properties are the
    legacy kwad.cpp values, not Pluto X measurements.
  </description>
</model>
