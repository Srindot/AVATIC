<?xml version="1.0"?>
<!-- Stand-alone balloon (red, 0.30 m) for inserting by hand. The arena
     plugin builds its own coloured, scaled balloons from the same mesh. -->
<sdf version="1.10">
  <model name="balloon">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh><uri>model://balloon/meshes/balloon_unit.stl</uri><scale>0.3 0.3 0.3</scale></mesh>
        </geometry>
        <material>
          <ambient>0.85 0.05 0.05 1</ambient>
          <diffuse>0.85 0.05 0.05 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <pbr><metal><metalness>0.0</metalness><roughness>0.35</roughness></metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
