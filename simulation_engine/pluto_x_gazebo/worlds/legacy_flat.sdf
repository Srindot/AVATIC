<?xml version="1.0"?>
<!--
  Flat test world for the legacy-stack Pluto X model.

  Physics: DART, fixed 1 ms step. The legacy controller period (10 ms) must
  be an integer multiple of this step (the plugin warns otherwise).
  Gravity must equal vehicle.gravity_m_s2 in the vehicle config (the plugin
  refuses to start otherwise).

  The orange cone at (3, 0, 0) mirrors the legacy world. The translucent
  marker at (1, 1, 1) shows the default position-hold target; it is visual
  only and does not follow configuration changes.
-->
<sdf version="1.10">
  <world name="pluto_legacy">
    <physics name="fixed_1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.35 0.5 0.3 1</ambient>
            <diffuse>0.35 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="reference_cone">
      <static>true</static>
      <pose>3 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cone><radius>0.15</radius><length>0.5</length></cone></geometry>
        </collision>
        <visual name="visual">
          <geometry><cone><radius>0.15</radius><length>0.5</length></cone></geometry>
          <material>
            <ambient>1 0.45 0 1</ambient>
            <diffuse>1 0.45 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="position_hold_target_marker">
      <static>true</static>
      <pose>1 1 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <transparency>0.5</transparency>
          <material>
            <ambient>0.1 0.4 1 1</ambient>
            <diffuse>0.1 0.4 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
