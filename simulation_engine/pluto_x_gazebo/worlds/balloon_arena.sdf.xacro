<?xml version="1.0"?>
<!--
  AVATIC balloon arena: flat field with boundary lines, the balloon arena
  plugin (balloons, popping, score, time limit) and the Sensors system for
  the vehicle camera. Generated by pluto_x_bringup arena.launch.py:

    xacro balloon_arena.sdf.xacro arena_config:=<yaml> profile_file:=<yaml> [result_file:=<path>]

  Physics as legacy_flat.sdf: DART, fixed 1 ms step, g = 9.81.
-->
<sdf version="1.10" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="arena_config" default=""/>
  <xacro:arg name="profile_file" default=""/>
  <xacro:arg name="result_file" default=""/>
  <xacro:property name="field_half_m" value="5.0"/>
  <xacro:property name="line_w" value="0.05"/>

  <world name="balloon_arena">
    <physics name="fixed_1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="pluto_x_arena_system" name="pluto_x_gazebo::ArenaSystem">
      <config_file>$(arg arena_config)</config_file>
      <profile_file>$(arg profile_file)</profile_file>
      <xacro:if value="${'$(arg result_file)' != ''}">
        <result_file>$(arg result_file)</result_file>
      </xacro:if>
    </plugin>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- Fill light from the opposite side, so no side of a balloon is fully
         in shadow (outdoor sky light). -->
    <light type="directional" name="sky_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.55 0.6 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.5 -0.2 -0.6</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.35 0.5 0.3 1</ambient>
            <diffuse>0.35 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Field boundary (10 m x 10 m) and take-off pad: visual only. -->
    <model name="field_markings">
      <static>true</static>
      <link name="link">
        <xacro:macro name="line" params="name x y sx sy">
          <visual name="${name}">
            <pose>${x} ${y} 0.002 0 0 0</pose>
            <geometry><box><size>${sx} ${sy} 0.002</size></box></geometry>
            <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
          </visual>
        </xacro:macro>
        <xacro:line name="north" x="0" y="${field_half_m}" sx="${2 * field_half_m}" sy="${line_w}"/>
        <xacro:line name="south" x="0" y="${-field_half_m}" sx="${2 * field_half_m}" sy="${line_w}"/>
        <xacro:line name="east" x="${field_half_m}" y="0" sx="${line_w}" sy="${2 * field_half_m}"/>
        <xacro:line name="west" x="${-field_half_m}" y="0" sx="${line_w}" sy="${2 * field_half_m}"/>
        <visual name="takeoff_pad">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
