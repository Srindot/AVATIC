# colcon build output (rebuild with: colcon build)
build/
install/
log/
# dev container builds (used when build/ came from outside the container)
build_container/
install_container/
log_container/

# recorded simulation runs and evaluation sessions (large, per user)
analysis/runs/*
!analysis/runs/.gitkeep
evaluation/sessions/*
!evaluation/sessions/.gitkeep
# the submission folder: filled by output/collect.py and by you (videos,
# the report); zip it to submit, never commit it
output/*
!output/README.md
!output/collect.py

# screen recordings, archives, ROS bags, Python environments
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.zip
*.tar.gz
rosbag2_*/
*.db3
*.mcap
.venv/
venv/
*.egg-info/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Claude Code (local session files)
.claude/

# editors / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
